# Copy this file to `.env` (already gitignored) and fill in real values.
# `.env` is never committed — see the "Secrets" note in README.md if one ever leaks.

# Required for LLM-powered recommendations in the Streamlit demo.
# Get your key at https://console.anthropic.com/
# Without this key the demo still works — it falls back to template recommendations.
ANTHROPIC_API_KEY=

# Optional: only needed if you publish/download a model from Hugging Face Hub.
HF_TOKEN=
HF_MODEL_REPO=
